{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPrintCost",
  "version": "0.1.0",
  "identifier": "de.monosystems.openprintcost",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenPrintCost — 3D-Druck-Kostenkalkulator",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Kostenkalkulation für 3D-Druck-Aufträge",
    "longDescription": "OpenPrintCost berechnet die Kosten von 3D-Druck-Aufträgen: Material, Maschinenzeit, Energie, Arbeitsschritte, Marge und Steuer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
