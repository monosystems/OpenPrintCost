{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPrintCost",
  "version": "0.1.7",
  "identifier": "de.monosystems.openprintcost",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenPrintCost — 3D Print Cost Calculator",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "category": "Productivity",
    "shortDescription": "Cost calculation for 3D printing jobs",
    "longDescription": "OpenPrintCost calculates the cost of 3D printing jobs: material, machine time, energy, work steps, margin, and tax.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMzQ4MTM5QzQ2RTE5MzEKUldReEdXN0VPWUUwN1MxWit4a1BVSlg0Mmp5SDJYbEpTVU82K0VWL1l4enBBa2VUSnNxTnc1blYK",
      "endpoints": [
        "https://github.com/monosystems/OpenPrintCost/releases/latest/download/latest.json"
      ]
    }
  }
}
