# Maintainer: OpenPrintCost Contributors
# This file is part of the OpenPrintCost repository.
#
# The package installs the official AppImage that is attached to every
# GitHub release. Build it with:
#
#   makepkg -si
#
# The pkgver below is kept in sync by scripts/set-version.sh — do not edit
# it by hand.

pkgname=openprintcost
pkgver=0.2.3
pkgrel=1
pkgdesc="Free, local-first cost calculator for 3D printing jobs"
arch=('x86_64')
url="https://github.com/monosystems/OpenPrintCost"
license=('Apache-2.0')
depends=('gtk3' 'webkit2gtk-4.1' 'librsvg')
optdepends=('libayatana-appindicator: system tray support')
options=('!strip' '!emptydirs')
source=(
  "$pkgname-$pkgver.AppImage::https://github.com/monosystems/OpenPrintCost/releases/download/v$pkgver/openprintcost-$pkgver-x86_64.AppImage"
  "icon-128.png::https://raw.githubusercontent.com/monosystems/OpenPrintCost/v$pkgver/src-tauri/icons/128x128.png"
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/$pkgname-$pkgver.AppImage" \
    "$pkgdir/usr/lib/$pkgname/openprintcost.AppImage"
  ln -s /usr/lib/$pkgname/openprintcost.AppImage "$pkgdir/usr/bin/$pkgname"

  install -Dm644 "$srcdir/icon-128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"

  install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=OpenPrintCost
Comment=Cost calculation for 3D printing jobs
Exec=/usr/lib/$pkgname/openprintcost.AppImage %U
Icon=$pkgname
Terminal=false
Categories=Office;ProjectManagement;
EOF
}
